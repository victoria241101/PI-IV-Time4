# Conexão com o MongoDB Atlas. Se a senha tiver @ : / # %, codifique (@ vira %40).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/petcare?appName=Cluster0

# Chave de assinatura dos tokens de login: exatamente 64 caracteres hexadecimais.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# E-mail (recuperação de senha e lembretes). Para Gmail, use senha de app, sem espaços.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=
SMTP_FROM=seu-email@gmail.com

# Endereço usado nos links dos e-mails de recuperação de senha.
FRONTEND_URL=http://localhost:3000/

# false desliga o agendador de lembretes de consulta (use false em testes
# para não enviar e-mail real). Ausente ou outro valor liga o agendador.
LEMBRETES_ATIVOS=false

# Senha inicial das contas criadas pelos scripts (veterinário, enfermeiro, secretária).
# Defina um valor forte e não o compartilhe.
SENHA_INICIAL_CONTAS=